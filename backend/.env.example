# ==============================================================================
# HRMS Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and update the values for your environment.
# All variables without defaults are REQUIRED.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# SQLite for local development (simple and easy to set up)
DATABASE_URL=sqlite+aiosqlite:///./hrms.db
DATABASE_SYNC_URL=sqlite:///./hrms.db

# PostgreSQL for production (uncomment and configure)
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/hrms
# DATABASE_SYNC_URL=postgresql://username:password@localhost:5432/hrms

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
# Debug mode: Set to False in production
DEBUG=True

# Secret key for JWT tokens (CHANGE IN PRODUCTION - use: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# JWT Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# CORS Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS
# Use ["*"] only in development
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# File Upload Configuration
# ------------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# ------------------------------------------------------------------------------
# Email Configuration (Optional)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-email-password
# SMTP_FROM_EMAIL=noreply@example.com

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
